{
  "$comment": [
    "Canonical MCP server set. Agent-neutral on purpose: no agent reads this file.",
    "`node scripts/install-mcp.mjs` renders it into each agent's own config format.",
    "",
    "Secrets are never values here. A credential is written as {\"env\": \"NAME\"} — a",
    "reference to an environment variable, resolved by the agent at connect time, not",
    "by this file and not by the renderer. Every NAME has an `export` in",
    "~/.config/secrets.zsh, which yadm keeps gpg-encrypted. That is what makes this",
    "file safe to commit.",
    "",
    "`\"enabled\": false` parks a server: it is rendered nowhere, and removed from",
    "every agent that already has it on the next run. The definition stays, which is",
    "the point — deleting the entry also uninstalls it, but throws away the",
    "definition, and most reasons to switch a server off are temporary. A parked",
    "server must carry a dated `note` saying what would have to be true to switch it",
    "back on; without one it is the entry nobody ever revisits.",
    "",
    "`purpose` is documentation only — it preserves the grouping the retired",
    "purpose-plugins used, and nothing keys off it."
  ],
  "version": 1,
  "servers": {
    "exa": {
      "purpose": "research",
      "description": "Exa web search",
      "transport": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": { "env": "EXA_API_KEY" }
      }
    },
    "playwright": {
      "purpose": "research",
      "description": "Self-hosted Playwright browser driver",
      "enabled": false,
      "note": "2026-07-31: origin down. Cloudflare returns 502 origin_bad_gateway, so Access accepts the credentials and the service behind it is not answering. Re-enable once it responds.",
      "transport": "http",
      "url": "https://playwright.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "PLAYWRIGHT_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "PLAYWRIGHT_CF_ACCESS_CLIENT_SECRET" }
      }
    },
    "brightdata": {
      "purpose": "research",
      "description": "Bright Data scraping proxy",
      "enabled": false,
      "note": "2026-07-31: origin down, same 502 origin_bad_gateway as playwright. Re-enable once it responds.",
      "transport": "http",
      "url": "https://brightdata.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "BRIGHTDATA_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "BRIGHTDATA_CF_ACCESS_CLIENT_SECRET" }
      }
    },
    "apify": {
      "purpose": "research",
      "description": "Apify actor runner",
      "transport": "http",
      "url": "https://mcp.apify.com/",
      "auth": { "type": "bearer", "token": { "env": "APIFY_API_TOKEN" } }
    },

    "github": {
      "purpose": "engineering",
      "description": "GitHub via the Copilot MCP endpoint",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "auth": { "type": "bearer", "token": { "env": "GITHUB_PAT" } }
    },
    "plane-life": {
      "purpose": "planning",
      "description": "Self-hosted Plane, `life` workspace — personal admin cases (coparenting, …). Version pinned: uvx re-resolves on every spawn, and an unpinned upstream is exactly what parked `n8n` below",
      "transport": "stdio",
      "command": "uvx",
      "args": ["plane-mcp-server==0.3.0", "stdio"],
      "env": {
        "PLANE_BASE_URL": "https://plane.loup-peluso.com",
        "PLANE_WORKSPACE_SLUG": "life",
        "PLANE_API_KEY": { "env": "PLANE_API_KEY" }
      }
    },
    "plane-decarvaloup": {
      "purpose": "planning",
      "description": "Self-hosted Plane, `decarvaloup` workspace — the wedding. One process serves one workspace: `PLANE_WORKSPACE_SLUG` is read once at startup, hence the second entry",
      "transport": "stdio",
      "command": "uvx",
      "args": ["plane-mcp-server==0.3.0", "stdio"],
      "env": {
        "PLANE_BASE_URL": "https://plane.loup-peluso.com",
        "PLANE_WORKSPACE_SLUG": "decarvaloup",
        "PLANE_API_KEY": { "env": "PLANE_API_KEY" }
      }
    },

    "slack": {
      "purpose": "communication",
      "description": "Self-hosted Slack bridge",
      "transport": "http",
      "url": "https://slack.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "SLACK_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "SLACK_CF_ACCESS_CLIENT_SECRET" }
      }
    },
    "whatsapp": {
      "purpose": "communication",
      "description": "Self-hosted WhatsApp bridge (whatsapp-mcp: Baileys, SQLite/FTS5, media + transcription)",
      "transport": "http",
      "url": "https://whatsapp.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "WHATSAPP_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "WHATSAPP_CF_ACCESS_CLIENT_SECRET" }
      },
      "auth": { "type": "bearer", "token": { "env": "WHATSAPP_MCP_TOKEN" } }
    },
    "imessage": {
      "purpose": "communication",
      "description": "Self-hosted iMessage bridge",
      "transport": "http",
      "url": "https://imessage.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "IMESSAGE_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "IMESSAGE_CF_ACCESS_CLIENT_SECRET" }
      }
    },

    "bank": {
      "purpose": "finance",
      "description": "Self-hosted bank aggregator",
      "enabled": false,
      "note": "2026-07-31: bank.loup-peluso.com has no A record — the host is gone, not just down. Re-enable once it resolves.",
      "transport": "http",
      "url": "https://bank.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "BANK_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "BANK_CF_ACCESS_CLIENT_SECRET" }
      }
    },
    "splitwise": {
      "purpose": "finance",
      "description": "Self-hosted Splitwise bridge",
      "transport": "http",
      "url": "https://splitwise.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "SPLITWISE_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "SPLITWISE_CF_ACCESS_CLIENT_SECRET" }
      }
    },

    "workspace-perso": {
      "purpose": "workspace",
      "description": "Personal Google Workspace",
      "transport": "http",
      "url": "https://google-perso.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "GOOGLE_PERSO_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "GOOGLE_PERSO_CF_ACCESS_CLIENT_SECRET" }
      }
    },
    "workspace-work": {
      "purpose": "workspace",
      "description": "Work Google Workspace",
      "transport": "http",
      "url": "https://google-work.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "GOOGLE_WORK_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "GOOGLE_WORK_CF_ACCESS_CLIENT_SECRET" }
      }
    },

    "google-maps": {
      "purpose": "navigation",
      "description": "Self-hosted Google Maps bridge",
      "transport": "http",
      "url": "https://maps.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "MAPS_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "MAPS_CF_ACCESS_CLIENT_SECRET" }
      }
    },
    "tesla": {
      "purpose": "navigation",
      "description": "Self-hosted Tesla vehicle control",
      "transport": "http",
      "url": "https://tesla.loup-peluso.com/mcp",
      "headers": {
        "CF-Access-Client-Id": { "env": "TESLA_CF_ACCESS_CLIENT_ID" },
        "CF-Access-Client-Secret": { "env": "TESLA_CF_ACCESS_CLIENT_SECRET" }
      }
    },

    "n8n": {
      "purpose": "automation",
      "description": "n8n workflow automation",
      "enabled": false,
      "note": "2026-07-31: upstream package is broken — `npx -y n8n-mcp` exits with Cannot find module 'zod'. Nothing to fix here; re-enable when a working version ships.",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "n8n-mcp"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true",
        "N8N_API_URL": { "env": "N8N_API_URL" },
        "N8N_API_KEY": { "env": "N8N_API_KEY" }
      }
    },
    "bitwarden": {
      "purpose": "security",
      "description": "Bitwarden vault; BW_SESSION comes from the `bwunlock` shell function",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@bitwarden/mcp-server"],
      "env": {
        "BW_SESSION": { "env": "BW_SESSION" },
        "BW_CLIENT_ID": { "env": "BW_CLIENT_ID" },
        "BW_CLIENT_SECRET": { "env": "BW_CLIENT_SECRET" }
      }
    }
  }
}
