{
  "agentation": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "agentation-mcp", "server"]
  },
  "apify": {
    "type": "http",
    "url": "https://mcp.apify.com/"
  },
  "argocd-perso": {
    "type": "stdio",
    "command": "sops",
    "args": ["exec-env", "mcp/secrets.sops.yaml", "npx -y argocd-mcp@0.9.0 stdio"],
    "env": { "ARGOCD_BASE_URL": "https://argocd.loup-peluso.com" }
  },
  "calcom": {
    "type": "http",
    "url": "https://mcp.cal.com/mcp"
  },
  "dagu": {
    "type": "http",
    "url": "https://dagu.loup-peluso.com/mcp",
    "headers": {
      "Authorization": "Bearer ${DAGU_MCP_API_KEY}"
    }
  },
  "exa": {
    "type": "http",
    "url": "https://mcp.exa.ai/mcp"
  },
  "google-maps": {
    "type": "http",
    "url": "https://maps.loup-peluso.com/mcp",
    "headers": {
      "CF-Access-Client-Id": "${MAPS_CF_ACCESS_CLIENT_ID}",
      "CF-Access-Client-Secret": "${MAPS_CF_ACCESS_CLIENT_SECRET}"
    }
  },
  "google-perso": {
    "type": "http",
    "url": "https://google-perso.loup-peluso.com/mcp"
  },
  "hindsight": {
    "type": "http",
    "url": "https://hindsight-api.loup-peluso.com/mcp/realm-perso-realm/",
    "headers": {
      "Authorization": "Bearer ${HINDSIGHT_API_KEY}"
    }
  },
  "imessage": {
    "type": "http",
    "url": "https://imessage.loup-peluso.com/mcp",
    "headers": {
      "CF-Access-Client-Id": "${IMESSAGE_CF_ACCESS_CLIENT_ID}",
      "CF-Access-Client-Secret": "${IMESSAGE_CF_ACCESS_CLIENT_SECRET}"
    }
  },
  "linear": {
    "type": "http",
    "url": "https://mcp.linear.app/mcp"
  },
  "lsp": {
    "type": "stdio",
    "command": "lsp-mcp-server"
  },
  "medicap": {
    "type": "http",
    "url": "https://medicap.site/api/mcp"
  },
  "nidi": {
    "type": "http",
    "url": "https://nidi.loup-peluso.com/mcp",
    "headers": {
      "Authorization": "Bearer ${NIDI_MCP_API_KEY}"
    }
  },
  "notion-perso": {
    "type": "http",
    "url": "https://mcp.notion.com/mcp?account=perso"
  },
  "slack": {
    "type": "http",
    "url": "https://mcp.slack.com/mcp",
    "oauth": {
      "clientId": "${SLACK_CLIENT_ID}",
      "clientSecret": "${SLACK_CLIENT_SECRET}",
      "callbackPort": 3118,
      "redirectUri": "http://localhost:3118/callback"
    }
  },
  "splitwise": {
    "type": "http",
    "url": "https://splitwise.loup-peluso.com/mcp",
    "headers": {
      "CF-Access-Client-Id": "${SPLITWISE_CF_ACCESS_CLIENT_ID}",
      "CF-Access-Client-Secret": "${SPLITWISE_CF_ACCESS_CLIENT_SECRET}"
    }
  },
  "tesla": {
    "type": "http",
    "url": "https://tesla.loup-peluso.com/mcp",
    "headers": {
      "CF-Access-Client-Id": "${TESLA_CF_ACCESS_CLIENT_ID}",
      "CF-Access-Client-Secret": "${TESLA_CF_ACCESS_CLIENT_SECRET}"
    }
  },
  "whatsapp": {
    "type": "http",
    "url": "https://whatsapp.loup-peluso.com/mcp",
    "headers": {
      "Authorization": "Bearer ${WHATSAPP_MCP_TOKEN}",
      "CF-Access-Client-Id": "${WHATSAPP_CF_ACCESS_CLIENT_ID}",
      "CF-Access-Client-Secret": "${WHATSAPP_CF_ACCESS_CLIENT_SECRET}"
    }
  },
  "rea": {
    "type": "stdio",
    "command": "rea",
    "args": ["mcp"],
    "env": {
      "GHIDRA_INSTALL_DIR": "/opt/homebrew/opt/ghidra/libexec",
      "JAVA_HOME": "/opt/homebrew/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"
    }
  },
  "overlord": {
    "type": "stdio",
    "command": "docker",
    "args": ["exec", "-i", "overlord", "overlord", "mcp"]
  },
  "shadcn": {
    "type": "stdio",
    "command": "npx",
    "args": ["-y", "shadcn@latest", "mcp"]
  }
}
